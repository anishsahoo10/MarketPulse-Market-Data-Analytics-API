# MarketPulse Environment Configuration Example
# Copy to .env for local overrides (never commit real secrets)

# Server Configuration
PORT=8080

# Active Spring Profile (default uses H2 for zero-config startup; set to 'postgres' for production)
SPRING_PROFILES_ACTIVE=default

# PostgreSQL Database Configuration (used when profile is postgres or via Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketpulse
DB_USER=marketpulse_user
DB_PASSWORD=marketpulse_secret

# External Market Data Provider Configuration
# Set to 'alphavantage' to use real Alpha Vantage API, or 'mock' for local simulation
MARKET_DATA_PROVIDER_TYPE=mock
MARKET_DATA_API_KEY=demo
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
PROVIDER_TIMEOUT_SECONDS=10
